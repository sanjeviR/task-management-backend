// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  role              String
  deleted_at        DateTime?
  remember_token    String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  created_by        Int?
  updated_by        Int?
  deleted_by        Int?
  activation_token  String?
  is_active         Boolean   @default(false)
  activated_at      DateTime?

  //self-Relations (Which Admin created/updated this user)
  creator User? @relation("UserCreator", fields: [created_by], references: [id])
  updater User? @relation("UserUpdater", fields: [updated_by], references: [id])
  deleter User? @relation("UserDeleter", fields: [deleted_by], references: [id])

  //reverse self-relations (Prisma requires these arrays to know who this user has created/updated)
  created_user User[] @relation("UserCreator")
  updated_user User[] @relation("UserUpdater")
  deleted_user User[] @relation("UserDeleter")

  //project relation
  managed_projects Project[] @relation("ProjectManager")
  created_projects Project[] @relation("ProjectCreator")
  updated_projects Project[] @relation("ProjectUpdater")
  deleted_projects Project[] @relation("ProjectDeleter")

  //task relation
  assigned_tasks Task[] @relation("TaskAssignee")
  created_tasks  Task[] @relation("TaskCreator")
  updated_tasks  Task[] @relation("TaskUpdater")
  deleted_tasks  Task[] @relation("TaskDeleter")

  //comments relation
  task_comments TaskComment[] @relation("CommentCreator")

  @@map("users")
}

model Project {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  manager_id   Int
  created_by   Int?
  updated_by   Int?
  deleted_by   Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  abbreviation String
  task_count   Int       @default(0)

  //relations
  manager User  @relation("ProjectManager", fields: [manager_id], references: [id])
  creator User? @relation("ProjectCreator", fields: [created_by], references: [id])
  updater User? @relation("ProjectUpdater", fields: [updated_by], references: [id])
  deleter User? @relation("ProjectDeleter", fields: [deleted_by], references: [id])

  //project has many tasks
  tasks Task[] @relation("ProjectTasks")

  @@map("projects")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    String
  status      String
  due_date    DateTime?
  attachments Json?
  assigned_to Int
  project_id  Int
  created_by  Int?
  updated_by  Int?
  deleted_by  Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  ticket_no   String    @unique

  //relations
  project  Project @relation("ProjectTasks", fields: [project_id], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigned_to], references: [id])
  creator  User?   @relation("TaskCreator", fields: [created_by], references: [id])
  updater  User?   @relation("TaskUpdater", fields: [updated_by], references: [id])
  deleter  User?   @relation("TaskDeleter", fields: [deleted_by], references: [id])

  //task has many comments
  comments TaskComment[] @relation("TaskComments")

  @@map("tasks")
}

model TaskComment {
  id         Int       @id @default(autoincrement())
  task_id    Int
  created_by Int
  comment    String    @db.Text
  attachment Json?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  //relation
  task    Task @relation("TaskComments", fields: [task_id], references: [id])
  creator User @relation("CommentCreator", fields: [created_by], references: [id])

  @@map("task_comments")
}
